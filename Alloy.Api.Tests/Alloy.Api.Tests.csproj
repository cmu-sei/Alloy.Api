<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ImplicitUsings stays off, as in the API projects; every file names its own usings. -->
    <LangVersion>latest</LangVersion>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Alloy.Api.Tests</RootNamespace>

    <!--
      Microsoft.Testing.Platform (global.json test.runner): the test project runs as its own test app, under
      `dotnet test` and `dotnet run` alike. xunit.v3 4 and later only run this way on the .NET 10 SDK.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- No central package management in this repository, so the versions of test-packages.props are here. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <!-- Hosts the API in process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- The SignalR client for EngineHub's real-connection test (Hubs/EngineHubConnectionTests). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alloy.Api\Alloy.Api.csproj" />
  </ItemGroup>

</Project>
